# -- Target Database (MySQL) --
DB_ROOT_PASSWORD=super_secret_root_password
DB_PORT=3306
DB_NAME=dummy_finance_db

# -- Bastion Backend --
API_PORT=8000
SECRET_KEY=generate_a_random_secret_key_here
SESSION_TTL_MINUTES=15

# -- Frontend --
FRONTEND_PORT=3000